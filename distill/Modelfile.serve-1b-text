# Our Llama 3.2 1B distilled from Muse Glimmer's short answers (distill/text_train.py), as a chat model on Glimmer's
# Ollama for the short calls llm.js routes to its small tier (LLM_SMALL_MODEL=serve-1b-text). The template is the one
# it was trained on (the same as Modelfile.serve-1b):
#   OLLAMA_HOST=127.0.0.1:11435 ollama create serve-1b-text -f distill/Modelfile.serve-1b-text
FROM /home/gino/serve/models/serve-1b-text-Q4_K_M.gguf
TEMPLATE """{{- range .Messages }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}<|eot_id|>{{- end }}<|start_header_id|>assistant<|end_header_id|>

"""
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"

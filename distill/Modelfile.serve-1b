# Our distilled Llama 3.2 1B as a chat model on Muse Glimmer's Ollama, for the short calls llm.js routes to it
# (LLM_SMALL_MODEL=serve-1b). The GGUF is the one the student worker serves (distill/worker.py):
#   OLLAMA_HOST=127.0.0.1:11435 ollama create serve-1b -f distill/Modelfile.serve-1b
FROM /home/gino/shuttlecoach-meta/jev/models/serve-jev-1b-v3-Q4_K_M.gguf
TEMPLATE """{{- range .Messages }}<|start_header_id|>{{ .Role }}<|end_header_id|>

{{ .Content }}<|eot_id|>{{- end }}<|start_header_id|>assistant<|end_header_id|>

"""
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|end_of_text|>"
